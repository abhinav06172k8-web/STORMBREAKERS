# Backend. Ollama is the default; no model API key is required.
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./eduplus.db
AI_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:4b
OLLAMA_KEEP_ALIVE=15m
OLLAMA_TIMEOUT_SECONDS=180
AI_MAX_CONCURRENT_TASKS=2
AI_CONFIDENCE_THRESHOLD=0.65
AI_CLOUD_FALLBACK=false
AI_TWO_PASS_VISION=true
AI_VISION_MAX_DIMENSION=2200
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=answer-sheets
YOUTUBE_API_KEY=
YOUTUBE_ENABLED=true
YOUTUBE_REGION_CODE=IN
YOUTUBE_RELEVANCE_LANGUAGE=en
YOUTUBE_MAX_RESULTS=5
MAX_UPLOAD_MB=20

# Frontend (public values only)
VITE_API_BASE_URL=http://localhost:8000
